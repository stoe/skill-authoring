{
  "name": "@stoe/skill-authoring",
  "version": "2.2.0",
  "type": "module",
  "description": "CLI to scaffold and validate GitHub Copilot skill packages (SKILL.md authoring toolkit)",
  "keywords": [
    "github-copilot",
    "skill",
    "cli",
    "validation"
  ],
  "author": {
    "name": "Stefan Stölzle",
    "email": "stefan@stoelzle.me",
    "url": "https://github.com/stoe"
  },
  "license": "MIT",
  "repository": "github:stoe/skill-authoring",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "skill-authoring": "./cli.js"
  },
  "exports": {
    ".": "./cli.js",
    "./commands/init": "./src/commands/init.js",
    "./commands/validate": "./src/commands/validate.js",
    "./core/discover": "./src/core/discover.js",
    "./core/frontmatter": "./src/core/frontmatter.js",
    "./core/fsx": "./src/core/fsx.js",
    "./core/log": "./src/core/log.js",
    "./core/reporters": "./src/core/reporters.js",
    "./validate": "./src/validate/index.js",
    "./validate/micro-templates": "./src/validate/micro-templates.js",
    "./validate/security": "./src/validate/security.js"
  },
  "files": [
    "cli.js",
    "src/",
    "license"
  ],
  "scripts": {
    "format": "npx prettier --config-precedence prefer-file --write . && eslint -c eslint.config.js . --fix",
    "prepare": "husky",
    "pretest": "npx eslint-config-prettier eslint.config.js",
    "test": "find src -name '*.js' -exec node --check {} + && node --test test/**/*.test.js && npx eslint -c eslint.config.js ."
  },
  "dependencies": {
    "ignore": "^7.0.10"
  },
  "devDependencies": {
    "@github/prettier-config": "^0.0.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9"
  },
  "husky": {
    "hooks": {
      "pre-commit": ".husky/pre-commit",
      "pre-push": ".husky/pre-push"
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run format --if-present"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prettier": "@github/prettier-config"
}
