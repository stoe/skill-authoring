# Exclude intentionally tracked generated output from language statistics.
dist/** linguist-generated=true
build/** linguist-generated=true
coverage/** linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
*.map linguist-generated=true
release-manifest.json linguist-generated=true
release-checksums.txt linguist-generated=true
sbom*.json linguist-generated=true
.github/inventory.md linguist-generated=true
.github/plugin/inventory.json linguist-generated=true
